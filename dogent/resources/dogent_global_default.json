      "ANTHROPIC_SMALL_FAST_MODEL": "GLM-5.2",
      "API_TIMEOUT_MS": 600000,
      "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": true
    },
    "glm5.3": {
      "ANTHROPIC_BASE_URL": "https://open.bigmodel.cn/api/anthropic",
